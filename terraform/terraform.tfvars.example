aws_region   = "us-east-1"
project_name = "svg-to-png"
environment  = "production"

# Keep the existing hostname and use its already-issued ACM certificate in us-east-1.
domain_name        = "svg2png.vuilendi.com"
acm_certificate_arn = "arn:aws:acm:us-east-1:<ACCOUNT_ID>:certificate/<CERTIFICATE_ID>"
