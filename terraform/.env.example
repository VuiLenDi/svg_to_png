# Copy to .env and fill in the existing domain/certificate values.
# Never commit .env or AWS credentials.
export AWS_PROFILE=dev-sso
export AWS_REGION=us-east-1
export TF_VAR_domain_name="svg2png.vuilendi.com"
export TF_VAR_acm_certificate_arn="arn:aws:acm:us-east-1:<ACCOUNT_ID>:certificate/<CERTIFICATE_ID>"
