# Terraform Sensitive Variables Example
# Copy to .env and fill in your own values
# DO NOT commit .env to git!

# AWS SSO Profile
export AWS_PROFILE=dev-sso
export AWS_REGION=us-east-1

# ECR Container Image (keep Account ID and ECR URL secure)
# Format: <ACCOUNT-ID>.dkr.ecr.<REGION>.amazonaws.com/svg-to-png:<VERSION>
export TF_VAR_container_image="<YOUR_ACCOUNT_ID><ECR_IMAGE>"

# ACM Certificate ARN (keep ARN secure - it contains Account ID)
# Request via: aws acm request-certificate --domain-name svg2png.vuilendi.com --validation-method DNS
export TF_VAR_acm_certificate_arn="<CERTIFICATE_ARN><CERTIFICATE_ID>"
